# ── LLM BRAIN ───────────────────────────────────────────────────────────────
# Pick ONE provider. LLM_PROVIDER defaults to "nvidia" if NVIDIA_API_KEY is set,
# otherwise "anthropic".
#
# Option A — Anthropic (Claude): best quality + BUILT-IN web search. Paid.
ANTHROPIC_API_KEY=sk-ant-...
#
# Option B — Groq: free, OpenAI-compatible, and built for low latency. Recommended
# for voice: the turns are short, which is exactly what its hardware is good at.
# Key (free) at console.groq.com/keys.
GROQ_API_KEY=gsk_...
# GROQ_MODEL=llama-3.3-70b-versatile          # default
# GROQ_FALLBACK_MODEL=llama-3.1-8b-instant    # used when the first is throttled
#
# Free-tier limits are per MODEL and per DAY: ~100k tokens/day on the 70b,
# separate buckets per model. A turn here costs roughly 3k tokens, so heavy
# testing can exhaust a day's budget in an evening — it recovers on a rolling
# window. Switching GROQ_MODEL to another model gives you a fresh bucket.
#
# Option C — NVIDIA NIM: free, OpenAI-compatible. Measured 2026-07-26 to be
# erratic on this account — identical requests returned in 2s, in 4s, and not at
# all in 45s — and most catalogue models are listed but not provisioned. Fine as
# a fallback, poor as the primary for anything latency-sensitive.
NVIDIA_API_KEY=nvapi-...
LLM_PROVIDER=nvidia
# NVIDIA_MODEL=qwen/qwen3-next-80b-a3b-instruct
#
# Neither Groq nor NVIDIA has built-in web search — add a search key below.
#
# Web search for the NVIDIA brain (add ONE; both have free tiers):
#   Tavily  → https://tavily.com  (recommended for assistants)
#   Brave   → https://brave.com/search/api
# TAVILY_API_KEY=tvly-...
# BRAVE_API_KEY=...

# Deepgram — speech-to-text, and text-to-speech (fallback voice). console.deepgram.com
DEEPGRAM_API_KEY=...

# ElevenLabs — preferred TTS voice (used automatically when both vars are set).
# Get a key at elevenlabs.io → profile → API Keys; voice ID from any voice's page.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL=eleven_turbo_v2_5

# Optional: Stripe TEST-mode key enables live payment-celebration polling.
STRIPE_SECRET_KEY=sk_test_put-your-stripe-test-key-here

# ───────────────────────────────────────────────────────────────────────────
# SKILLS / INTEGRATIONS — for the agentic "act on my behalf" skills.
# You connect these yourself; Artemis never creates accounts or enters creds.
# Until a section is filled, that skill runs in SIMULATED mode (drafts/plans only,
# nothing is actually sent). Sending always requires a spoken/typed "yes".
#
# SMS (messaging skill) — Twilio: console.twilio.com → Account SID + Auth Token,
# and a Twilio phone number to send from (E.164, e.g. +15551234567).
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=
#
# Email triage (Gmail) — implemented operations are read + recoverable Trash;
# there is no Gmail draft/send endpoint. Browser nudges leave Send to you.
# Google's required gmail.modify grant is broader and technically send-capable,
# so protect the refresh token.
# Setup: Google Cloud console → APIs & Services → Credentials → Create OAuth
# client, type "Desktop app". Paste the id/secret below, restart Artemis, then
# open http://localhost:4100/auth/google once — approve, copy the printed
# refresh token here, restart again. Then say "Artemis, check my email."
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=
#
# WhatsApp — Meta WhatsApp Business Cloud API: permanent token + phone number ID.
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_ID=

# Optional overrides:
# ASSISTANT_USER_NAME=Todor        # how she addresses you (default: "sir")
# ARTEMIS_VOICE=aura-asteria-en   # Deepgram TTS voice
# ARTEMIS_STT_MODEL=nova-2        # Deepgram STT model
# The wake word runs fully on-device via openWakeWord (ONNX/WASM) — no key or
# account needed. Models live in public/oww/ (see README to install them). Which
# phrase is active is decided by public/oww/manifest.json, not by a setting here:
# it ships as "Hey Jarvis" and only changes when a custom model is published with
# `python wake/bundle.py` (and `--rollback` puts it back).
# PORT=4100
#
# --- Access Artemis from your phone / another computer -------------------------
# Default: localhost-only (safest). To reach her from other devices on your
# wi-fi, set these. The API can read your Gmail, so exposure ALWAYS needs a
# token (auto-generated + printed at startup if left blank) and wants HTTPS so
# a phone's microphone works (mic is blocked on plain http off-device).
# ARTEMIS_HOST=0.0.0.0             # bind to your LAN (your local network, NOT the public internet)
# ARTEMIS_ACCESS_TOKEN=...         # password other devices enter once — use a long random value, not a word
# ARTEMIS_HTTPS=1                  # self-signed cert so phone voice works (accept the browser warning once)
#
# If you reach Artemis through a TUNNEL or reverse proxy (Cloudflare/ngrok/Tailscale)
# instead of ARTEMIS_HOST, set BOTH of these — otherwise remote clients are refused:
# ARTEMIS_REQUIRE_AUTH=1           # demand the access token even though the bind stays 127.0.0.1
# ARTEMIS_ALLOWED_HOSTS=foo.trycloudflare.com   # comma-separated Host header(s) the tunnel presents
